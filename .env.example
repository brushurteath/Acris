# Node 24 supports: node --env-file=.env server.mjs
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
# Grant admin locally AFTER registering: node server.mjs --grant-admin your@email.com
# Set to 1 only when using HTTPS in front of the Node server.
COOKIE_SECURE=0
# Optional directory for the SQLite database (never commit it).
DATA_DIR=./data
